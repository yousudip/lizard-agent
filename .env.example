# Copy to .env and fill in. .env is gitignored.

# TypeSafe / Jev API key — https://typesafe.ai
TYPESAFE_API_KEY=

# Optional: override the model (default: jev-latest)
# JEV_MODEL=jev-latest

# Optional: attach to your own Chrome instead of a clean browser.
# Start Chrome with a dedicated profile first:
#   "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
#     --remote-debugging-port=9222 \
#     --user-data-dir="$HOME/.lizard-chrome"
# CHROME_CDP_URL=http://localhost:9222

# LLM baseline for the race — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite
